#!/usr/bin/env bash
# log-output <file...> — register Bash-produced deliverables. The mirror-output
# PostToolUse hook only sees Write/Edit tool saves; anything generated by a shell
# command (PDFs, renders, builds) must be registered explicitly. Mirrors into
# ~/claude-outputs/ as <project>--<file> (same naming as the hook) and logs to
# ~/.cache/claude-writes.tsv. Portable (no GNU-only tools).
set -uo pipefail

rev_lines() { awk '{a[NR]=$0} END{for(i=NR;i>0;i--) print a[i]}'; }
abspath() {
    if command -v realpath >/dev/null 2>&1; then realpath "$1" 2>/dev/null
    else case "$1" in /*) printf '%s\n' "$1" ;; *) printf '%s/%s\n' "$PWD" "$1" ;; esac
    fi
}

log="$HOME/.cache/claude-writes.tsv"
mkdir -p "$HOME/claude-outputs" "$HOME/.cache"
for fp in "$@"; do
    fp=$(abspath "$fp") || continue
    [ -f "$fp" ] || continue
    printf '%s\t%s\n' "$(date +%s)" "$fp" >> "$log"
    case "$fp" in
        */output/*) proj=$(basename "${fp%%/output/*}") ;;
        "$HOME"/projects/*) rel="${fp#"$HOME"/projects/}"; proj="${rel%%/*}" ;;
        *) proj=$(basename "$(dirname "$fp")") ;;
    esac
    cp -f "$fp" "$HOME/claude-outputs/${proj}--$(basename "$fp")"
done
rev_lines < "$log" | awk -F'\t' '!seen[$2]++' | head -n 300 | rev_lines > "$log.tmp" && mv "$log.tmp" "$log"
