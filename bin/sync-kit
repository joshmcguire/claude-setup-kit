#!/usr/bin/env bash
# sync-kit [status|pull|push] [filter] [--quiet]
# Drift control between the claude-setup-kit repo and this machine's live copies.
#
#   status  show which managed files differ (default)
#   pull    copy live -> kit (you improved something on this machine; bring it home)
#   push    copy kit -> live (the repo moved ahead; update this machine)
#   filter  optional substring; only process pairs whose kit path matches
#
# CLAUDE.md files are compared/synced ABOVE the machine-specific marker only, so
# per-machine sections never count as drift and never get overwritten.
# Kit location: $CLAUDE_KIT_DIR, else ~/.config/claude-setup-kit/path (written by install.sh).
set -uo pipefail

MARKER="MACHINE-SPECIFIC BELOW"

KIT="${CLAUDE_KIT_DIR:-}"
if [ -z "$KIT" ] && [ -f "$HOME/.config/claude-setup-kit/path" ]; then
  KIT=$(cat "$HOME/.config/claude-setup-kit/path")
fi
if [ -z "$KIT" ] || [ ! -d "$KIT" ]; then
  echo "sync-kit: kit repo not found (set CLAUDE_KIT_DIR or run install.sh once)" >&2
  exit 1
fi

CMD="${1:-status}"
[ $# -gt 0 ] && shift
QUIET=0; FILTER=""
for a in "$@"; do
  case "$a" in --quiet) QUIET=1 ;; *) FILTER="$a" ;; esac
done

# Emit managed pairs: mode<TAB>kit-path<TAB>live-path
# mode: full = whole-file sync; marker = sync only above the machine-specific marker.
# show-toolkit.sh is intentionally NOT managed: its content is per-machine by design.
pairs() {
  for f in "$KIT"/bin/*; do
    [ -f "$f" ] || continue
    printf 'full\t%s\t%s\n' "$f" "$HOME/.local/bin/$(basename "$f")"
  done
  for f in "$KIT"/hooks/*.sh; do
    [ -f "$f" ] || continue
    case "$f" in */show-toolkit.sh) continue ;; esac
    printf 'full\t%s\t%s\n' "$f" "$HOME/.claude/hooks/$(basename "$f")"
  done
  for f in "$KIT"/commands/*.md; do
    [ -f "$f" ] || continue
    printf 'full\t%s\t%s\n' "$f" "$HOME/.claude/commands/$(basename "$f")"
  done
  if [ -d "$KIT/templates/project" ]; then
    find "$KIT/templates/project" -type f | while IFS= read -r f; do
      rel="${f#"$KIT"/templates/project/}"
      printf 'full\t%s\t%s\n' "$f" "$HOME/templates/project/$rel"
    done
  fi
  printf 'marker\t%s\t%s\n' "$KIT/home/CLAUDE.md" "$HOME/CLAUDE.md"
  printf 'marker\t%s\t%s\n' "$KIT/global-claude/CLAUDE.md" "$HOME/.claude/CLAUDE.md"
}

above_marker() { awk -v m="$MARKER" 'index($0, m) { exit } { print }' "$1"; }
from_marker()  { awk -v m="$MARKER" 'f { print; next } index($0, m) { f=1; print }' "$1"; }
has_marker()   { grep -q "$MARKER" "$1" 2>/dev/null; }

DRIFT=0
report() { DRIFT=$((DRIFT+1)); [ "$QUIET" -eq 1 ] || printf '  %-7s %s\n' "$1" "$2"; }

splice() { # splice <src-of-baseline> <src-of-tail> <dest>  (marker mode)
  local tmp; tmp=$(mktemp)
  { above_marker "$1"; from_marker "$2"; } > "$tmp" && mv "$tmp" "$3"
}

while IFS=$(printf '\t') read -r mode kf lf; do
  [ -n "$FILTER" ] && case "$kf" in *"$FILTER"*) ;; *) continue ;; esac

  if [ ! -f "$lf" ]; then
    case "$CMD" in
      status) report "missing" "$lf" ;;
      push)   mkdir -p "$(dirname "$lf")" && cp "$kf" "$lf" && echo "  installed $lf" ;;
      pull)   echo "  skip (missing on machine): $lf" ;;
    esac
    continue
  fi

  if [ "$mode" = "full" ]; then
    if ! cmp -s "$kf" "$lf"; then
      case "$CMD" in
        status) report "differs" "${kf#"$KIT"/} <> $lf" ;;
        pull)   cp "$lf" "$kf" && echo "  pulled  ${kf#"$KIT"/}" ;;
        push)   cp "$kf" "$lf" && echo "  pushed  $lf" ;;
      esac
    fi
  else # marker mode
    if ! has_marker "$kf" || ! has_marker "$lf"; then
      report "no-marker" "$lf (add the '$MARKER' marker line, then sync)"
      continue
    fi
    if ! diff -q <(above_marker "$kf") <(above_marker "$lf") >/dev/null; then
      case "$CMD" in
        status) report "differs" "${kf#"$KIT"/} <> $lf (above marker)" ;;
        pull)   splice "$lf" "$kf" "$kf" && echo "  pulled  ${kf#"$KIT"/} (baseline only)" ;;
        push)   splice "$kf" "$lf" "$lf" && echo "  pushed  $lf (baseline only)" ;;
      esac
    fi
  fi
done <<EOF
$(pairs)
EOF

if [ "$CMD" = "status" ]; then
  if [ "$DRIFT" -eq 0 ]; then
    [ "$QUIET" -eq 1 ] || echo "kit and machine are in sync"
  else
    echo "sync-kit: $DRIFT file(s) drifted (run 'sync-kit status' for detail, then pull or push)"
    exit 1
  fi
fi
exit 0
