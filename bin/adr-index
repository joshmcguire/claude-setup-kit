#!/usr/bin/env bash
# adr-index [project-dir]
# Regenerates the Index table in decisions/README.md from the ADR files themselves
# (number from filename, title from the first heading, status from frontmatter).
# The table is a build artifact: never hand-edit it.
set -euo pipefail

DIR="${1:-.}"
DEC="$DIR/decisions"
README="$DEC/README.md"
[ -f "$README" ] || { echo "error: $README not found" >&2; exit 1; }

TABLE="| # | Decision | Status |
|---|---|---|"
for f in "$DEC"/[0-9][0-9][0-9][0-9]-*.md; do
  [ -e "$f" ] || continue
  base="$(basename "$f")"
  num="${base%%-*}"
  [ "$num" = "0000" ] && continue   # skip the template
  status="$(awk '$1=="status:" { sub("^status: *",""); print; exit }' "$f")"
  title="$(awk '/^# / { sub("^# *[0-9]+ *[—-]+ *",""); sub("^# *",""); print; exit }' "$f")"
  TABLE="$TABLE
| [$num]($base) | $title | ${status:-unknown} |"
done

awk -v table="$TABLE" '
  /^## Index/ { print; print ""; print table; skip=1; next }
  skip && /^## / { skip=0 }
  skip { next }
  { print }
' "$README" > "$README.tmp" && mv "$README.tmp" "$README"

echo "regenerated index table in $README"
